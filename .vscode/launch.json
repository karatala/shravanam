{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev:desktop",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug app",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Web (PWA)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev:web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Android LAN",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev:android",
      "cwd": "${workspaceFolder}"
    }
  ]
}
